# Qalandarana — environment variables (template).
# Copy to .env.local and fill in real values. .env.local is gitignored; this
# file is committed as documentation. Every var here is REQUIRED — src/lib/env.ts
# fails closed at first use if any is missing (spec §9, checklist #4).

# --- Database ---
DATABASE_URL=postgres://user:pass@host/db?sslmode=require # Neon Postgres connection string

# --- Audio storage ---
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx # Vercel Blob read/write token (stores original .ogg)

# --- Telegram bridge (father's voice notes arrive here) ---
TELEGRAM_BOT_TOKEN=123456:ABC-DEF... # from @BotFather when you create the bot
TELEGRAM_WEBHOOK_SECRET=long-random-string # secret path segment verifying calls really come from Telegram
TELEGRAM_ALLOWED_USER_IDS=123456789,987654321 # from @userinfobot — only these sender IDs may submit notes
TELEGRAM_ADMIN_CHAT_ID=123456789 # Moiz's chat id — where failure / needs-fix alerts are sent

# --- AI providers (behind swappable adapters) ---
OPENAI_API_KEY=sk-... # Whisper transcription (and GPT structuring if selected)
ANTHROPIC_API_KEY=sk-ant-... # Claude structuring (if selected)
STRUCTURER_PROVIDER=claude # which LLM structures entries: claude | openai

# --- Internal wiring ---
INTERNAL_API_SECRET=long-random-string # protects the internal stage-chaining route from outside callers
AUTH_SECRET=long-random-string # signs the admin session JWT (jose)
APP_URL=http://localhost:3000 # absolute base URL used to build review/admin links

# --- Admin (single account) ---
ADMIN_EMAIL=you@example.com # the one admin login email
ADMIN_PASSWORD_HASH=$2a$... # bcrypt hash of the admin password (never the plaintext)

# --- Access gate ---
FAMILY_PASSPHRASE=some-shared-word # shared passphrase the family types to enter the journey
PUBLIC_MODE=false # true removes the passphrase gate at public launch (unused until Phase 2)
